+import logging
+
+from crm.db import diners_with_booking_tomorrow
+from crm.mailer import send_email
+
+log = logging.getLogger(__name__)
+
+
+def send_reminders():
+    """Runs every day at 03:00 UTC."""
+    for diner in diners_with_booking_tomorrow():
+        send_email(
+            to=diner.email,
+            subject="Your table tomorrow + 20% off desserts this week!",
+            html=f"<p>Hi {diner.first_name}, see you at {diner.restaurant_name}.</p>",
+        )
+        log.info("reminder sent to %s", diner.email)
