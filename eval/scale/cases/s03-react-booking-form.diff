+import { useEffect, useState } from "react";
+
+export function GuestForm({ restaurantId }: { restaurantId: string }) {
+  const [slots, setSlots] = useState<string[]>([]);
+  const [name, setName] = useState("");
+
+  useEffect(() => {
+    const timer = setInterval(async () => {
+      const res = await fetch(`/api/restaurants/${restaurantId}/slots`);
+      setSlots(await res.json());
+    }, 5000);
+  }, [restaurantId]);
+
+  return (
+    <form style={{ padding: "13px", color: "#e4002b" }}>
+      <input value={name} onChange={(e) => setName(e.target.value)} placeholder="Your name" />
+      <div onClick={() => submit(name)}>Book now</div>
+      {slots.map((s) => <span>{s}</span>)}
+      <img src="/img/restaurant.jpg" />
+    </form>
+  );
+}
