{
  "description": "jrfc: apply the engineering standards to an agent's tool calls (Jev) and review the change when the agent stops. Active only in repositories with a jrfc workspace; see docs/hooks.mdx in the jrfc repository.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jrfc-hook\"", "timeout": 10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jrfc-hook\"", "timeout": 10}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jrfc-hook\"", "timeout": 600}]
      }
    ]
  }
}
