#!/usr/bin/env bash
# CI-agnostic jrfc PR review. Run from the root of the repository under review.
#
#   jrfc-pr-review [--base <ref>] [--out-dir <dir>] [--post <pr-number> [--dry-run]] [--fail-on-blocking]
#
# Needs: TYPESAFE_API_KEY (Jev selection), Claude Code auth for `claude -p`
# (ANTHROPIC_API_KEY in CI), and a corpus: .jrfc/jrfc.yaml in the repository (local rules +
# `extends:` the organisation corpus) or JRFC_EXTENDS=owner/name@ref. --post needs `gh` and GH_TOKEN and is
# the only step that writes outside the working directory (`jrfc publish`, deterministic).
# --dry-run with --post reads the PR and writes publish-plan.json without changing it.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

base="origin/${GITHUB_BASE_REF:-main}"
out_dir=".jrfc-out/pr"
post=""
fail=""
dry_run=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base) base="$2"; shift 2 ;;
    --out-dir) out_dir="$2"; shift 2 ;;
    --post) post="$2"; shift 2 ;;
    --fail-on-blocking) fail="--fail-on-blocking"; shift ;;
    --dry-run) dry_run="--dry-run"; shift ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 64 ;;
  esac
done

mkdir -p "$out_dir"
git diff --no-color "$base"...HEAD > "$out_dir/pr.diff"
if [[ ! -s "$out_dir/pr.diff" ]]; then
  echo "jrfc-pr-review: empty diff against $base, nothing to review"
  exit 0
fi

status=0
"$here/jrfc" review "$out_dir/pr.diff" --out-dir "$out_dir" --format github $fail || status=$?

if [[ -n "$post" && -f "$out_dir/github-review.json" ]]; then
  # Idempotent: new findings only, fixed threads resolved, one summary comment updated in place.
  "$here/jrfc" publish --pr "$post" --dir "$out_dir" $dry_run
fi
exit $status
