{
  "description": "shall: apply the engineering standards to an agent's tool calls (Jev) and review the change when the agent stops. Active only in repositories with a shall workspace; see README 'While an agent works'.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/shall-hook\"", "timeout": 10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/shall-hook\"", "timeout": 10}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/shall-hook\"", "timeout": 600}]
      }
    ]
  }
}
